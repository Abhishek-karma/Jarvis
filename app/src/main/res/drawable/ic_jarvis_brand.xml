<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis Brand Logo & Copyright Emblem
  Combines the dual-arc AI core with a refined outer orbital ring
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
