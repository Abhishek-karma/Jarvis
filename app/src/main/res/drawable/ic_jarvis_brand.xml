    <!-- Inner primary arch -->
    <path
        android:strokeColor="#3D63F6"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M18,27.5 A6,6 0 0 1 30,27.5" />

    <!-- Center energy node -->
    <path
        android:fillColor="#3D63F6"
        android:pathData="M24,27.5 m-2.8,0 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0" />
