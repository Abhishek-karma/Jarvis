<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant of the adaptive launcher icon. Same layers as ic_launcher.xml;
  the launcher's mask decides how much of the foreground is visible, so the
  mark is already centered inside the 66-unit safe circle.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
