<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon — API 26+ (Android 8.0 Oreo and above).

  Three layers:
    1. background  : solid color (white), read from ic_launcher_background
    2. foreground  : the Jarvis mark in brand indigo
    3. monochrome  : solid-ink version of the same mark, used when the user
                     has "Themed icons" enabled in their launcher (Android 13+)
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
